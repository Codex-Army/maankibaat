<body>
  <main class="container">

    <div class="eyebrow">THE OFFICIAL CTF PORTAL</div>

    <h1>Mitron Market</h1>

    <p class="subtitle">
      Welcome, Mitron. Your investigation starts here.
    </p>

    <img
      class="hero-image"
      src="https://akm-img-a-in.tosshub.com/indiatoday/images/story/202405/pm-modi-smiling-064650291-16x9_0.jpeg?VersionId=jB9Lbi.Ok_FF1q5NWLNuMtK9MVa7EfRp&size=690:388"
      alt="Mitron Market featured image"
      onerror="this.style.display='none'"
    >

    <!-- Hidden audio: it plays when Login is clicked. -->
    <audio
      id="memeAudio"
      preload="auto"
      src="https://www.myinstants.com/media/sounds/modi-modi-modi-modi-kids.mp3">
    </audio>

    <section class="card">
      <h2>🔐 Staff Login</h2>

      <form id="loginForm">
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Username"
          autocomplete="username"
          required
        >

        <input
          type="password"
          id="password"
          name="password"
          placeholder="Password"
          autocomplete="current-password"
          required
        >

        <button type="submit" id="loginButton">LOGIN</button>
      </form>

      <div class="result" id="loginResult" role="status" aria-live="polite"></div>
    </section>

    <section class="card">
      <h2>📨 Secure Message Vault</h2>
      <p>Some messages are restricted to specific staff IDs. Investigate the requests carefully, Mitron.</p>
      <a href="/secure-message" style="display:block;text-align:center;padding:14px;background:linear-gradient(90deg,#a10e19,#ed2525);color:#fff;text-decoration:none;font-weight:bold;border-radius:8px;">OPEN SECURE MESSAGES</a>
    </section>

    <section class="card">
      <h2>⭐ Public Reviews</h2>

      <div class="review">
        <b>amit</b>: best website ever
      </div>

      <div class="review">
        <b>bhakt_420</b>: ache din aa gaye
      </div>

      <div class="review">
        <b>modi_fanboy</b>: mast site
      </div>
    </section>

    <section class="card">
      <h2>🎙️ Mann Ki Baat — Janata Ka Feedback</h2>
      <p>Try the browser-local Stored XSS training challenge. Your test feedback stays in your browser.</p>
      <a href="/mann-ki-baat" style="display:block;text-align:center;padding:14px;background:linear-gradient(90deg,#a10e19,#ed2525);color:#fff;text-decoration:none;font-weight:bold;border-radius:8px;">OPEN XSS CHALLENGE</a>
    </section>

    <section class="card">
      <h2>💻 Yogi Ji Ki Free Laptop Yojana</h2>
      <p>Claim one free laptop. Can you find the race condition and make the claim counter exceed one?</p>
      <a href="/yogi-laptop" style="display:block;text-align:center;padding:14px;background:linear-gradient(90deg,#a10e19,#ed2525);color:#fff;text-decoration:none;font-weight:bold;border-radius:8px;">OPEN RACE CONDITION CHALLENGE</a>
    </section>

    <section class="card">
      <h2>🏁 Flag Submission</h2>
      <p class="notice">
        ⚠️ Solve all 5 challenges. Each input below tells you which challenge's flag belongs there.
      </p>

      <form id="flagForm">
        <label for="flag1"><b>Flag 1 — Modi Ka Dimag (Price Manipulation)</b></label>
        <input type="text" id="flag1" placeholder="Paste the flag from /modi" autocomplete="off" required>

        <label for="flag2"><b>Flag 2 — Admin Access (JWT)</b></label>
        <input type="text" id="flag2" placeholder="Paste the flag from the admin challenge" autocomplete="off" required>

        <label for="flag3"><b>Flag 3 — Secure Message Vault (IDOR, userId 420)</b></label>
        <input type="text" id="flag3" placeholder="Paste the flag from Gyanesh's private message" autocomplete="off" required>

        <label for="flag4"><b>Flag 4 — Mann Ki Baat (Stored XSS)</b></label>
        <input type="text" id="flag4" placeholder="Paste the flag from the XSS challenge" autocomplete="off" required>

        <label for="flag5"><b>Flag 5 — Yogi Ji's Free Laptop (Race Condition)</b></label>
        <input type="text" id="flag5" placeholder="Paste the flag after multiple laptop claims" autocomplete="off" required>

        <button type="submit" id="flagButton">SUBMIT ALL 5 FLAGS</button>
      </form>

      <div class="result" id="flagResult" role="status" aria-live="polite"></div>
    </section>

    <footer>
      MITRON MARKET // CTF TRAINING ENVIRONMENT
    </footer>

  </main>

  <script>
    const loginForm = document.getElementById("loginForm");
    const loginButton = document.getElementById("loginButton");
    const loginResult = document.getElementById("loginResult");
    const memeAudio = document.getElementById("memeAudio");

    const flagForm = document.getElementById("flagForm");
    const flagButton = document.getElementById("flagButton");
    const flagResult = document.getElementById("flagResult");

    const trollMessages = [
      "Skill issue detected 😭",
      "Mitron... password galat hai 👀",
      "Access denied by Vishwaguru 💀",
      "Nice try hacker ji 😈",
      "Authentication failed successfully 😂",
      "Aapka password jumla nikla 😭",
      "Server bhi confuse ho gaya 😵",
      "Error 404: Skills not found 💀"
    ];

    function showResult(element, message) {
      element.textContent = message;
      element.classList.add("visible");
    }

    function randomTroll() {
      return trollMessages[
        Math.floor(Math.random() * trollMessages.length)
      ];
    }

    loginForm.addEventListener("submit", async function (event) {
      event.preventDefault();

      /*
       * Start audio directly from the user's click.
       * No visible audio player is required.
       */
      memeAudio.currentTime = 0;
      memeAudio.play().catch(function () {
        showResult(
          loginResult,
          "Audio could not be loaded. Check your internet connection."
        );
      });

      const username = document.getElementById("username").value.trim();
      const password = document.getElementById("password").value;

      loginButton.disabled = true;
      loginButton.textContent = "AUTHENTICATING...";

      try {
        const response = await fetch("/login", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ username, password })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          showResult(loginResult, "Login successful! Redirecting to admin...");
          // The JWT is stored in an HttpOnly cookie by /login; do not put it in the URL.
          window.location.assign("/admin");
          return;
        } else {
          showResult(loginResult, randomTroll());
        }
      } catch (error) {
        showResult(
          loginResult,
          "Connection error. Check that the CTF server is running."
        );
      } finally {
        loginButton.disabled = false;
        loginButton.textContent = "LOGIN";
      }
    });

    flagForm.addEventListener("submit", async function (event) {
      event.preventDefault();

      const flag1 = document.getElementById("flag1").value.trim();
      const flag2 = document.getElementById("flag2").value.trim();
      const flag3 = document.getElementById("flag3").value.trim();
      const flag4 = document.getElementById("flag4").value.trim();
      const flag5 = document.getElementById("flag5").value.trim();

      flagButton.disabled = true;
      flagButton.textContent = "VERIFYING FLAGS...";

      try {
        const response = await fetch("/submit-flags", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ flag1, flag2, flag3, flag4, flag5 })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          showResult(
            flagResult,
            "🎉 ALL 5 FLAGS VERIFIED!\n\nReward Code: " + data.reward + "\n\nMASTER FLAG: " + data.masterFlag
          );
        } else {
          showResult(
            flagResult,
            data.message || "Wrong flags! Try again, hacker ji 😈"
          );
        }
      } catch (error) {
        showResult(
          flagResult,
          "Connection error. Check that the CTF server is running."
        );
      } finally {
        flagButton.disabled = false;
        flagButton.textContent = "SUBMIT ALL 5 FLAGS";
      }
    });
  </script>
</body>
