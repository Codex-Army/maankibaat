<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090909">

  <title>Mitron Market | Official Portal</title>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/modi_hai_to_admin_hai.js" defer></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(ellipse at top, #351010 0%, #100909 42%, #050505 100%);
      color: #f5eeee;
      font-family: Arial, Helvetica, sans-serif;
    }

    .container {
      width: min(92%, 760px);
      margin: 0 auto;
      padding: 38px 0 50px;
      text-align: center;
    }

    .eyebrow {
      color: #ff7777;
      letter-spacing: 4px;
      font-size: 11px;
      font-weight: bold;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(36px, 7vw, 58px);
      margin: 0 0 10px;
      color: #ff3434;
      text-transform: uppercase;
      letter-spacing: 2px;
      text-shadow: 0 0 22px #ff222255;
    }

    .subtitle {
      color: #b9aaaa;
      margin-bottom: 28px;
      font-size: 14px;
    }

    .hero-image {
      display: block;
      width: 100%;
      max-width: 620px;
      height: auto;
      max-height: 350px;
      object-fit: cover;
      margin: 0 auto 28px;
      border: 1px solid #7d3030;
      border-radius: 14px;
      box-shadow: 0 12px 40px #0009;
    }

    .card {
      background: linear-gradient(145deg, #191313, #0d0b0b);
      border: 1px solid #512525;
      border-radius: 14px;
      padding: 26px;
      margin: 20px auto;
      text-align: left;
      box-shadow: 0 8px 30px #0005;
    }

    .card h2 {
      color: #ff5252;
      margin: 0 0 18px;
      font-size: 21px;
    }

    .card p {
      color: #d7cbcb;
      line-height: 1.6;
    }

    .card input {
      display: block;
      width: 100%;
      margin: 12px 0;
      padding: 14px;
      background: #080707;
      color: #fff;
      border: 1px solid #493030;
      border-radius: 8px;
      outline: none;
      font-size: 15px;
    }

    .card input:focus {
      border-color: #ff4545;
      box-shadow: 0 0 0 3px #ff45451c;
    }

    .card button {
      display: block;
      width: 100%;
      padding: 14px;
      margin-top: 15px;
      background: linear-gradient(90deg, #a10e19, #ed2525);
      color: white;
      font-weight: bold;
      font-size: 15px;
      letter-spacing: 1px;
      border: 0;
      border-radius: 8px;
      cursor: pointer;
      transition: transform .2s, filter .2s;
    }

    .card button:hover {
      transform: translateY(-2px);
      filter: brightness(1.15);
    }

    .card button:disabled {
      opacity: .6;
      cursor: wait;
      transform: none;
    }

    .result {
      display: none;
      margin-top: 16px;
      padding: 14px;
      background: #090707;
      border: 1px solid #532727;
      border-radius: 8px;
      color: #ffb1b1;
      line-height: 1.7;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .result.visible {
      display: block;
    }

    .review {
      padding: 12px 0;
      border-bottom: 1px solid #302020;
    }

    .review:last-child {
      border-bottom: none;
    }

    .review b {
      color: #ff7474;
    }

    .notice {
      color: #ffb9b9 !important;
      font-size: 13px;
      background: #350e0e55;
      border: 1px dashed #793131;
      border-radius: 8px;
      padding: 12px;
    }

    footer {
      color: #776969;
      font-size: 12px;
      margin-top: 28px;
      letter-spacing: 1px;
    }

    @media (max-width: 520px) {
      .container {
        width: 92%;
        padding-top: 26px;
      }

      .card {
        padding: 20px;
      }

      .hero-image {
        max-height: 250px;
      }
    }
  </style>

